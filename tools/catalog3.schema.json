{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scout.edgelab.one/learn/catalog3.schema.json",
  "title": "scout-learning-catalog:3",
  "description": "The library catalog: modules in display order with their lessons in teaching order, the lessons' concept keys and subtopic titles, the shared concept keys with aliases, and the site block. No role, no sequence, no expectations or technologies, no posting counts, no text bodies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "site", "concept_keys_version", "modules", "lessons", "keys"],
  "properties": {
    "schema_version": {"const": "scout-learning-catalog:3"},
    "catalog_version": {"type": "string", "minLength": 1, "description": "<site_version>+keys<concept_keys_version>: changes whenever the site version or the key list changes"},
    "concept_keys_version": {"type": "integer", "minimum": 1},
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "site_version", "lessons_path", "practice_path", "modules_path"],
      "properties": {
        "base_url": {"type": "string", "pattern": "^https://[^/]+(/[a-z0-9-]+)*$"},
        "site_version": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]+\\.[0-9]+$"},
        "lessons_path": {"type": "string", "minLength": 1},
        "practice_path": {"type": "string", "minLength": 1},
        "modules_path": {"type": "string", "minLength": 1}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "order", "lessons"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "lessons": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}}
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "module", "concept_keys", "subtopics", "has_practice", "practice_kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "module": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "concept_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "description": "primary key first, then the secondary keys"},
          "subtopics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title"],
              "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}}
            }
          },
          "has_practice": {"type": "boolean"},
          "practice_kind": {"enum": ["tool", "case", "artifact", null]}
        }
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "display", "area", "category", "technical", "aliases"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "display": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "technical": {"type": "boolean"},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
